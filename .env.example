# ─── Testmobil — ALL environment variables documented here. NEVER commit real .env ───
# Copy to .env for local dev. Values below are dev-only placeholders.

# Core
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
APP_ENV=dev

# Auth (principle §13/§21: secrets server-side only)
JWT_ACCESS_SECRET=change-me-64-random-chars-min
JWT_REFRESH_SECRET=change-me-64-random-chars-min
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ARGON2_PARALLELISM=1

# Database (docker-compose dev defaults)
DATABASE_URL=postgres://testmobil:testmobil@localhost:5432/testmobil
DB_POOL_MAX=10

# Redis (presence, rate-limit, token denylist, pub/sub)
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible; MinIO in dev) — handover photos & driver documents
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=testmobil-private
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
PRESIGN_UPLOAD_TTL_SECONDS=300
PRESIGN_READ_TTL_SECONDS=300

# Maps provider adapter (server-side ONLY; browser tokens issued by backend)
MAPS_PROVIDER=local          # local | google | mapbox
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Payments provider adapter (never expose in frontend)
PAYMENTS_PROVIDER=stub       # stub | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_FEE_PERCENT=20   # platform commission (also seedable via pricing_rules)

# Push / notification adapters
PUSH_PROVIDER=none           # none | fcm | apns-via-provider
FIREBASE_SERVER_KEY=

# Rate limiting
RATE_LIMIT_MAX_PER_MIN=120
AUTH_RATE_LIMIT_MAX_PER_MIN=10

# CORS — comma-separated allowed origins per frontend app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Ops alerting for SOS (Phase 11)
OPS_ALERT_WEBHOOK_URL=
